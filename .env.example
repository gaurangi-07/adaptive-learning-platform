# ===================================================
# ADAPTIVE LEARNING PLATFORM - ENVIRONMENT VARIABLES
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL + Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adaptive_learning_db?schema=public"

# Module 1 Integration: Mock Student Baseline Settings (Disabled in Production)
ENABLE_MOCK_STUDENT=true
DEFAULT_STUDENT_ID=12

# Module 2 Adaptive Assessment Settings
SESSION_QUESTION_COUNT=10
QUESTION_TIMEOUT_SECONDS=90
CONSECUTIVE_CORRECT_FOR_UPGRADE=3
INCORRECT_WINDOW_FOR_DOWNGRADE=3
INCORRECT_THRESHOLD_FOR_DOWNGRADE=2

# Module 3 Integration Settings
ENABLE_MOCK_QUESTION_BANK=true
