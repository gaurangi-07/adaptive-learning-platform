# ===================================================
# ADAPTIVE LEARNING PLATFORM — ENVIRONMENT CONFIGURATION
# ===================================================

# ── Server Configuration ───────────────────────────
PORT=5001
NODE_ENV=production

# ── Frontend URL for CORS ───────────────────────────
# In production on Render: set to your deployed Vercel frontend URL
# Multiple comma-separated URLs are supported (e.g. https://parakh.vercel.app,http://localhost:5173)
CLIENT_URL=https://your-frontend.vercel.app
# FRONTEND_URL is supported as an alternative alias
FRONTEND_URL=https://your-frontend.vercel.app

# ── Database (Neon PostgreSQL + Prisma) ────────────
# In production on Render: paste your Neon connection string with sslmode=require
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Authentication / JWT Secret ─────────────────────
# Strong random 64+ char secret used to sign and verify student JWT tokens
JWT_SECRET=your_super_secret_jwt_key_generate_with_openssl_rand_base64_32

# ── Module 1 Settings ──────────────────────────────
# Set to false in production to enforce real database baselines
ENABLE_MOCK_STUDENT=false
DEFAULT_STUDENT_ID=1

# ── Module 2 Adaptive Assessment Settings ───────────
SESSION_QUESTION_COUNT=10
QUESTION_TIMEOUT_SECONDS=90
CONSECUTIVE_CORRECT_FOR_UPGRADE=3
INCORRECT_WINDOW_FOR_DOWNGRADE=3
INCORRECT_THRESHOLD_FOR_DOWNGRADE=2

# ── Module 3 Question Bank & AI Generation ─────────
# When true, falls back to 65 curated questions if question bank has fewer than required
ENABLE_MOCK_QUESTION_BANK=true

# AI Provider: "mock", "groq", or "openai"
AI_PROVIDER=mock

# Groq Configuration (when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
