// ===================================================================
// PARAKH Adaptive Learning Platform — Database Schema (Prisma ORM)
// Module 2: Adaptive Testing System
// ===================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------------

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  TIMED_OUT
}

// -------------------------------------------------------------------
// MODULE 1 MODELS (Student related)
// -------------------------------------------------------------------

model Student {
  id                    Int                 @id @default(autoincrement())
  fullName              String
  email                 String              @unique
  hashedPassword        String
  college               String?
  branch                String?
  yearOfStudy           Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  adaptiveAssessments   AdaptiveAssessment[]
  preAssessmentAttempts PreAssessmentAttempt[]
  preAssessmentResponses PreAssessmentResponse[]
  baselineResult        BaselineResult?
}

model BaselineResult {
  id                Int      @id @default(autoincrement())
  studentId         Int      @unique
  student           Student  @relation(fields: [studentId], references: [id])
  overallAccuracy   Float    // 0‑100
  totalQuestions    Int
  correctAnswers    Int
  topicProficiency  Json     // e.g. {"DBMS":0.8,"DSA":0.6}
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// -------------------------------------------------------------------
// MODULE 2 MODELS (Adaptive Assessment)
// -------------------------------------------------------------------

model AdaptiveAssessment {
  id                 String               @id @default(uuid())
  studentId          Int
  student            Student @relation(fields: [studentId], references: [id])
  subject            String               @default("Mathematics")
  status             AssessmentStatus     @default(IN_PROGRESS)
  currentDifficulty  Int                  @default(2) // 1=Easy, 2=Medium, 3=Hard
  totalQuestions     Int                  @default(10)
  answeredCount      Int                  @default(0)
  score              Int                  @default(0)
  accuracy           Float                @default(0.0)
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Relations
  assessmentQuestions AssessmentQuestion[]
  studentResponses   StudentResponse[]
  topicProficiencies TopicProficiency[]
  difficultyHistory  DifficultyHistory[]
}

model AssessmentQuestion {
  id               String              @id @default(uuid())
  assessmentId     String
  assessment       AdaptiveAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId       String              // FK to Module 3 Question.id
  orderIndex       Int                 // 1‑based order
  topic            String
  competency       String
  difficulty       Int                 // 1,2,3
  questionText     String
  optionsJson      Json                // [{id:"A",text:"..."},...]
  correctOption    String              // server‑side only
  explanation      String?
  allocatedSeconds Int                 @default(90)
  presentedAt      DateTime            @default(now())

  // Relation back to responses (optional, for completeness)
  studentResponses StudentResponse[]
}

model StudentResponse {
  id                      String              @id @default(uuid())
  assessmentId            String
  assessment              AdaptiveAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId              String              // FK to Module 3 Question.id
  assessmentQuestionId    String              @unique
  assessmentQuestion      AssessmentQuestion  @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  selectedOption          String?             // A‑D or null
  isCorrect               Boolean             @default(false)
  isTimedOut              Boolean             @default(false)
  startedAt               DateTime
  submittedAt             DateTime
  responseTimeMs          Int                 // ms
  responseTimeSec         Float               // seconds
  difficulty              Int                 // 1‑3
  topic                   String
  createdAt               DateTime            @default(now())

  @@index([assessmentId])
  @@index([assessmentId, topic])
  @@index([questionId])
}

model TopicProficiency {
  id                 String   @id @default(uuid())
  assessmentId       String
  assessment         AdaptiveAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId          Int
  topic              String
  initialScore       Float   @default(50.0) // baseline from Module 1
  currentProficiency Float   @default(50.0)
  questionsAttempted Int     @default(0)
  questionsCorrect   Int     @default(0)
  currentDifficulty  Int     @default(2)
  consecutiveCorrect Int     @default(0)
  recentOutcomes     String  @default("[]") // JSON array of booleans
  updatedAt          DateTime @updatedAt

  @@unique([assessmentId, topic])
  @@index([studentId, topic])
}

model DifficultyHistory {
  id                 String   @id @default(uuid())
  assessmentId       String
  assessment         AdaptiveAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  topic              String
  questionOrder      Int      // which question triggered
  previousDifficulty Int
  newDifficulty      Int
  reason             String   // e.g., "3_CONSECUTIVE_CORRECT"
  details            String?
  createdAt          DateTime @default(now())

  @@index([assessmentId])
  @@index([assessmentId, topic])
}

// -------------------------------------------------------------------
// MODULE 1 PRE‑ASSESSMENT MODELS (used for initial assessment)
// -------------------------------------------------------------------

model PreAssessmentAttempt {
  id               String   @id @default(uuid())
  studentId        Int
  student          Student @relation(fields: [studentId], references: [id])
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  status           AssessmentStatus @default(IN_PROGRESS)
  totalQuestions   Int
  correctAnswers   Int @default(0)
  topicProficiency Json?   // filled on finish
  questionIds      Json    // ["q1","q2",...]

  responses        PreAssessmentResponse[]
}

model PreAssessmentResponse {
  id              String   @id @default(uuid())
  attemptId       String
  attempt         PreAssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId       Int?
  student         Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId      String
  selectedOption  String?   // A‑D or null
  responseTimeSec Float    @default(0.0)
  answeredAt      DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([studentId])
}

// -------------------------------------------------------------------
// MODULE 3 MODELS (Question Bank)
// -------------------------------------------------------------------

model Question {
  id              String   @id @default(uuid())
  subject         String
  topic           String
  competency      String   @default("")
  difficulty      Int      // 1‑3
  questionText    String   @db.Text
  correctOption   String   // A‑D
  explanation     String   @db.Text
  status          QuestionStatus @default(PENDING)
  createdBy       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  source          String   @default("MANUAL") // MANUAL or AI
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  options         QuestionOption[]
  reviewHistory   QuestionReviewHistory[]

  @@index([subject, topic, difficulty])
  @@index([status])
  @@index([createdAt])
  @@map("questions")
}

model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionLabel  String   // A‑D
  optionText   String   @db.Text
  isCorrect    Boolean  @default(false)

  @@index([questionId])
  @@map("question_options")
}

model QuestionReviewHistory {
  id               String   @id @default(uuid())
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewerId       String?
  previousStatus   QuestionStatus?
  newStatus        QuestionStatus
  comment          String?   @db.Text
  createdAt        DateTime @default(now())

  @@index([questionId])
  @@index([reviewerId])
}

// End of schema
